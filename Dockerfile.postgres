# Custom PostgreSQL with Star Wars Data Pre-loaded
FROM pgvector/pgvector:pg15

# Install Python and required packages for data processing
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    python3-venv \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set up Python environment
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

# Copy Star Wars data and initialization scripts
COPY data/processed/all_dialogue.json /docker-entrypoint-initdb.d/data/
COPY characters.json /docker-entrypoint-initdb.d/data/
COPY src/star_wars_rag/ /docker-entrypoint-initdb.d/src/star_wars_rag/
COPY init_star_wars_db.py /docker-entrypoint-initdb.d/

# Set environment variables
ENV POSTGRES_DB=star_wars_rag
ENV POSTGRES_USER=starwars_admin
ENV POSTGRES_PASSWORD=your_secure_password_123

# Make initialization script executable
RUN chmod +x /docker-entrypoint-initdb.d/init_star_wars_db.py

# The initialization script will run automatically when the container starts
# and the database is created for the first time
